# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API keys -> the secret key (service_role on older projects,
# "secret key" on projects using the newer key system). Server-side only, never
# expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# No JWT secret needed here: tokens are verified against Supabase's public JWKS
# endpoint (derived from SUPABASE_URL above), which works with the newer
# per-project signing keys and needs no secret stored on this side.

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
