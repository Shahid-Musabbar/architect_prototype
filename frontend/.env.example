# Copy to .env (and restart `npm run dev`) to enable real "Sign in with Google" via Supabase.
# See the "Google sign-in" section in README.md for full setup steps.

# Supabase Project Settings -> API -> Project URL / anon key. Both safe to expose (RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Python backend (see ../architect-2-backend). Defaults to http://localhost:8000.
VITE_API_URL=http://localhost:8000
